# SocialPulse AI Environment Configuration

# Optional: Set your Anthropic Claude API Key for live AI generation.
# If omitted or empty, the application seamlessly runs in intelligent mock simulation mode.
VITE_AI_API_KEY=

# Model identifier (defaults to claude-sonnet-4-6 or claude-3-7-sonnet-20250219)
VITE_AI_MODEL=claude-sonnet-4-6

# Optional backend proxy URL if routing requests through your own server
VITE_API_URL=https://api.anthropic.com/v1/messages
